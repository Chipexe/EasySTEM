{
  "name": "easystem-connector",
  "version": "0.1.0",
  "private": true,
  "description": "EasySTEM Connector — Arduino Nano upload and sensor monitor",
  "author": "EasySTEM",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "prepare:tools": "node scripts/prepare-tools.mjs",
    "dist": "electron-builder --win nsis portable --x64"
  },
  "dependencies": { "serialport": "^13.0.0" },
  "devDependencies": { "electron": "^43.0.0", "electron-builder": "^26.0.12" },
  "build": {
    "appId": "vn.easystem.connector",
    "productName": "EasySTEM Connector",
    "directories": { "output": "release" },
    "files": [ "src/**/*", "package.json" ],
    "extraResources": [ { "from": "resources/arduino", "to": "arduino", "filter": [ "**/*", "!downloads/**/*", "!sketches/**/*", "!cache/**/*", "!prepare-config.json" ] } ],
    "asar": true,
    "npmRebuild": false,
    "win": { "target": [ "nsis", "portable" ], "icon": "src/ui/icon.ico", "signAndEditExecutable": false },
    "nsis": { "oneClick": true, "perMachine": false, "runAfterFinish": false, "artifactName": "EasySTEM-Connector-Setup-${version}.exe" },
    "portable": { "artifactName": "EasySTEM-Connector-Portable-${version}.exe" }
  }
}
